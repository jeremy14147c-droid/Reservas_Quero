# Configuración del Sistema Quero Gastrobar
# Copiar este archivo como .env y completar los valores reales

# Base de datos PostgreSQL (puerto 5433 en desarrollo local para PostgreSQL 16)
DATABASE_URL=postgresql://quero_app:TU_CLAVE@localhost:5433/quero

# Clave secreta para sesiones y CSRF (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria

# URL base para generar códigos QR (usar IP o dominio en producción)
BASE_URL=http://localhost:5000

# Correo SMTP (para proyecto final; en MVP pueden quedar vacíos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quero Gastrobar <notificaciones@querogastrobar.pe>
